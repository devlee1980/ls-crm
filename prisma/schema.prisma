generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(REP)
  division  Division?
  region    String?
  avatarUrl String?

  isActive               Boolean   @default(true)
  loginAttempts          Int       @default(0)
  lockedUntil            DateTime?
  sessionTimeoutMinutes  Int       @default(480)

  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers      Customer[]
  forecasts      Forecast[]
  actionItems    ActionItem[]
  revenueRecords RevenueRecord[]
  pipelineDeals  PipelineDeal[] @relation("PipelineDeals")

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  REP
  CS_REP
}

enum Division {
  LS_US
  LS_CANADA
}

// ─── Entity (Multi-tenancy) ──────────────────────────────────────────────────

model Entity {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  customers      Customer[]
  products       Product[]
  forecasts      Forecast[]
  revenueRecords RevenueRecord[]
  actionItems    ActionItem[]
  attachments    Attachment[]

  @@map("entities")
}

// ─── Customer ────────────────────────────────────────────────────────────────

model Customer {
  id               String         @id @default(cuid())
  name             String
  accountNumber    String?        @unique
  industry         String?
  type             CustomerType   @default(DISTRIBUTOR)
  wholesalePercent Float          @default(0)
  retailPercent    Float          @default(100)
  rating           Int            @default(0)
  status           CustomerStatus @default(ACTIVE)
  notes            String?
  website          String?
  division         Division?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  assignedRepId String?
  assignedRep   User?   @relation(fields: [assignedRepId], references: [id])

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  locations      CustomerLocation[]
  contacts       Contact[]
  actionItems    ActionItem[]
  forecasts      Forecast[]
  revenueRecords RevenueRecord[]
  attachments    Attachment[]
  pipelineDeals  PipelineDeal[]
  accountScore   AccountScore?

  @@map("customers")
}

enum CustomerType {
  DISTRIBUTOR
  RETAILER
  DIRECT
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

model CustomerLocation {
  id        String   @id @default(cuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label     String   @default("Main")
  address1  String
  address2  String?
  city      String
  state     String
  zip       String
  country   String   @default("US")
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_locations")
}

model Contact {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  title         String?
  phone         String?
  email         String?
  isPrimary     Boolean  @default(false)
  decisionMaker Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("contacts")
}

// ─── Product / Item Master ───────────────────────────────────────────────────

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  description    String?
  category       String?
  unitPrice      Float
  uom            String   @default("Each")
  pricePerGallon Float?
  gallonsPerCase Float?
  litersPerCase  Float?
  market         String   @default("US")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  forecastItems ForecastItem[]
  revenueItems  RevenueItem[]
  attachments   Attachment[]

  @@map("products")
}

// ─── Forecasting ─────────────────────────────────────────────────────────────

model Forecast {
  id          String         @id @default(cuid())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id])
  repId       String
  rep         User           @relation(fields: [repId], references: [id])
  period      String
  startDate   DateTime
  endDate     DateTime
  status      ForecastStatus @default(DRAFT)
  notes       String?
  totalAmount Float          @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  items ForecastItem[]

  @@map("forecasts")
}

enum ForecastStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model ForecastItem {
  id               String   @id @default(cuid())
  forecastId       String
  forecast         Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  quantity         Float
  unitPrice        Float
  wholesalePercent Float    @default(0)
  retailPercent    Float    @default(100)
  lineTotal        Float
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("forecast_items")
}

// ─── Revenue ─────────────────────────────────────────────────────────────────

model RevenueRecord {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  repId       String?
  rep         User?    @relation(fields: [repId], references: [id])
  period      String
  date        DateTime
  totalAmount Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  items RevenueItem[]

  @@map("revenue_records")
}

model RevenueItem {
  id              String        @id @default(cuid())
  revenueRecordId String
  revenueRecord   RevenueRecord @relation(fields: [revenueRecordId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Float
  unitPrice       Float
  lineTotal       Float
  createdAt       DateTime      @default(now())

  @@map("revenue_items")
}

// ─── Action Items ─────────────────────────────────────────────────────────────

model ActionItem {
  id           String           @id @default(cuid())
  customerId   String?
  customer     Customer?        @relation(fields: [customerId], references: [id])
  assignedToId String?
  assignedTo   User?            @relation(fields: [assignedToId], references: [id])
  title        String
  description  String?
  priority     ActionPriority   @default(MEDIUM)
  status       ActionItemStatus @default(TODO)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  @@map("action_items")
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActionItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ─── Pipeline ────────────────────────────────────────────────────────────────

model PipelineDeal {
  id            String        @id @default(cuid())
  title         String
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  assignedRepId String?
  assignedRep   User?         @relation("PipelineDeals", fields: [assignedRepId], references: [id])
  stage         PipelineStage @default(LEAD)
  value         Float         @default(0)
  probability   Int           @default(10)
  expectedClose DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("pipeline_deals")
}

enum PipelineStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

// ─── Analytics ───────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  userEmail String?
  userRole  String?
  path      String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([path])
  @@map("page_views")
}

// ─── Attachments (S3) ────────────────────────────────────────────────────────

model Attachment {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  fileName   String
  fileSize   Int
  mimeType   String
  s3Key      String
  s3Url      String
  uploadedBy String?
  createdAt  DateTime  @default(now())

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  @@map("attachments")
}

// ─── Account Scoring (US Market) ─────────────────────────────────────────────

model AccountScore {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Strategic Alignment (max 25 weighted pts)
  sharedVision         Int @default(0)
  valueLsCapabilities  Int @default(0)
  capturesScienceValue Int @default(0)

  // Demand Creation (max 23 weighted pts)
  createGrowerDemand  Int @default(0)
  agronomistInfluence Int @default(0)
  trialCapability     Int @default(0)

  // Route-to-Market (max 23 weighted pts)
  accessStrategicMarkets Int @default(0)
  forceMultiplier        Int @default(0)
  channelControl         Int @default(0)

  // Commercial (max 9 weighted pts)
  marginAlignment   Int @default(0)
  pricingPhilosophy Int @default(0)

  // Operational (max 7 weighted pts)
  supplyChainStrength Int @default(0)
  easeOfDoing         Int @default(0)

  // Financial (max 8 weighted pts — score of 8 at weight 8)
  financialStability Int @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account_scores")
}
